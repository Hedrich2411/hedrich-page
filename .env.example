# SMTP del formulario de contacto. Sin prefijo PUBLIC_, así que nunca llegan al navegador.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Buzón desde el que salen los mensajes. Debe coincidir con la cuenta autenticada.
SMTP_ADMIN_EMAIL=
# Nombre que se ve como remitente.
SMTP_SENDER_NAME=hedrich.dev
# A dónde llegan las consultas. Si se deja vacío, van a SMTP_ADMIN_EMAIL.
SMTP_TO=
