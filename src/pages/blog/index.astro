---
import CourseCard from "../../components/blog/CourseCard.astro";
import Hero from "../../components/blog/Hero.astro";
import PostRow from "../../components/blog/PostRow.astro";
import Progress from "../../components/blog/Progress.astro";
import Icon from "../../components/shared/Icon.astro";
import Layout from "../../layouts/Layout.astro";
import { getLoosePosts, getOutlines, getTopics } from "../../lib/blog";

const outlines = await getOutlines();
const loose = await getLoosePosts();
const topics = await getTopics();
---

<Layout title="Blog" description="Notas sobre backend, integraciones y despliegue. Algunas sueltas, otras agrupadas en cursos.">
	<main class="pb-0">
		{/* the library band sits a shade off the page so the reading list below breathes */}
		<div>
			<div class="mx-auto max-w-5xl px-6 pb-20 pt-12">
				<Hero topics={topics} />

				{outlines.length > 0 && (
					<section data-group class="mt-16">
						<div data-reveal class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
							<h2 class="heading text-3xl">Para leer en orden</h2>
							<p class="shrink-0 text-sm text-base-content/50">
								{outlines.length} {outlines.length === 1 ? "ruta de aprendizaje" : "rutas de aprendizaje"}
							</p>
						</div>

						<ul class="mt-8 grid gap-6 lg:grid-cols-2">
							{outlines.map((outline, i) => <CourseCard outline={outline} dark={i === 0} index={i + 1} />)}
						</ul>

						<p data-reveal class="mt-6 flex items-center gap-2.5 text-sm text-base-content/50">
							<Icon name="save" class="size-4 shrink-0" />
							Tu avance se guarda en este navegador. Podés volver y continuar donde te quedaste.
						</p>
					</section>
				)}
			</div>
		</div>

		{loose.length > 0 && (
			<div class="mx-auto max-w-5xl px-6 py-20">
				<section data-group>
					<div data-reveal class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
						<h2 class="heading text-3xl">Una idea, una lectura.</h2>
						<p class="shrink-0 text-sm text-base-content/50">Más recientes primero ↓</p>
					</div>
					<p data-reveal class="mt-3 text-base-content/60">Notas independientes para ir directo a lo que necesitás.</p>

					<ul class="mt-10 border-b border-base-300">
						{loose.map((post) => <PostRow post={post} />)}
					</ul>

					<p data-reveal class="mt-6 text-sm text-base-content/45">
						Estás al día. Acá iré compartiendo lo que aprenda en el siguiente proyecto.
					</p>
				</section>

				<p data-empty class="hidden py-16 text-center text-base-content/60">
					Nada con ese tema todavía. Probá con otra búsqueda.
				</p>
			</div>
		)}
	</main>

	<Progress />
</Layout>
