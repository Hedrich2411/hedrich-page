---
import Legal from "../layouts/Legal.astro";
import site from "../data/site.json";
// ponytail: placeholder copy, replace with the real terms
const email = site.contact.email;
const sections: [string, string][] = [
	["1. Aceptación de los términos", "Al descargar, instalar o utilizar esta aplicación, usted acepta quedar vinculado por estos Términos y Condiciones. Si no está de acuerdo, no utilice la aplicación."],
	["2. Uso de la aplicación", "La aplicación se ofrece para uso personal y no comercial. Usted se compromete a no utilizarla con fines ilícitos ni de forma que pueda dañar, deshabilitar o sobrecargar el servicio."],
	["3. Privacidad", "El tratamiento de sus datos personales se rige por nuestra Política de Privacidad. Al usar la aplicación, usted consiente dicho tratamiento."],
	["4. Propiedad intelectual", "Todo el contenido, marcas y código de la aplicación son propiedad de sus respectivos titulares y están protegidos por las leyes de propiedad intelectual aplicables."],
	["5. Limitación de responsabilidad", 'La aplicación se proporciona "tal cual", sin garantías de ningún tipo. No seremos responsables de daños derivados del uso o la imposibilidad de uso de la aplicación.'],
	["6. Modificaciones", "Nos reservamos el derecho de modificar estos términos en cualquier momento. Los cambios entrarán en vigor al publicarse en esta página."],
	["7. Contacto", `Para consultas sobre estos términos, escríbanos a <a class="link" href="mailto:${email}">${email}</a>.`],
];
---

<Legal
	title="Términos y Condiciones"
	description="Condiciones de uso de las aplicaciones publicadas por hedrich.dev."
	actualizado="28 de agosto de 2026"
	sections={sections}
	footer={{ href: "/privacidad", label: "Política de Privacidad" }}
/>
