---
import Legal from "../layouts/Legal.astro";
import site from "../data/site.json";
// ponytail: placeholder copy, adjust to the data the published apps really collect
const email = site.contact.email;
const sections: [string, string][] = [
	["1. Responsable", "hedrich.dev es responsable del tratamiento de los datos personales recopilados a través de sus aplicaciones publicadas en Google Play."],
	["2. Datos que recopilamos", "Podemos recopilar información que usted nos proporciona directamente (como su nombre o correo electrónico) e información técnica generada por el uso de la aplicación (identificadores del dispositivo, registros de errores y datos de uso anónimos)."],
	["3. Uso de la información", "Utilizamos los datos para prestar y mejorar el servicio, corregir errores, brindar soporte y cumplir obligaciones legales. No vendemos sus datos personales a terceros."],
	["4. Servicios de terceros", "La aplicación puede utilizar servicios de terceros (como Google Play Services o herramientas de analítica) que recopilan información conforme a sus propias políticas de privacidad."],
	["5. Conservación y seguridad", "Conservamos los datos solo durante el tiempo necesario para los fines descritos y aplicamos medidas técnicas razonables para protegerlos contra accesos no autorizados."],
	["6. Sus derechos", "Usted puede solicitar el acceso, rectificación o eliminación de sus datos personales en cualquier momento escribiéndonos al correo de contacto indicado abajo."],
	["7. Menores", "La aplicación no está dirigida a menores de 13 años y no recopilamos intencionalmente información de ellos."],
	["8. Cambios en esta política", "Podemos actualizar esta política ocasionalmente. Los cambios serán publicados en esta página con la fecha de actualización."],
	["9. Contacto", `Para consultas sobre privacidad, escríbanos a <a class="link" href="mailto:${email}">${email}</a>.`],
];
---

<Legal
	title="Política de Privacidad"
	description="Cómo se tratan los datos personales en las aplicaciones publicadas por hedrich.dev."
	actualizado="28 de agosto de 2026"
	sections={sections}
	footer={{ href: "/terminos", label: "Términos y Condiciones" }}
/>
