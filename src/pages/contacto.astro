---
import { siWhatsapp } from "simple-icons";
import Channel from "../components/contact/Channel.astro";
import ContactForm from "../components/contact/ContactForm.astro";
import Faq from "../components/services/Faq.astro";
import Process from "../components/services/Process.astro";
import PageHeader from "../components/shared/PageHeader.astro";
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";

const { contact, status } = site;
const telefono = contact.phone.replace(/\D/g, "");
const greeting = encodeURIComponent("Hola Hedrich, te escribo por un proyecto.");

const tips = [
	"Qué querés construir, en una o dos frases.",
	"Si ya existe algo o arrancamos de cero.",
	"Para cuándo lo necesitás.",
	"Un presupuesto aproximado, si ya lo tenés definido.",
];
---

<Layout title="Contacto" description="Escribime por correo, WhatsApp o LinkedIn. Respondo el mismo día hábil.">
	<main class="mx-auto max-w-5xl px-6 pb-16 pt-12">
		<PageHeader
			eyebrow="Respondo el mismo día hábil"
			title="Contacto"
			lead="Contame qué necesitás y te respondo el mismo día hábil. Si no es algo que pueda hacer yo, te lo digo de una."
		>
			<p data-reveal class="mt-6 text-sm text-muted">{contact.location} · {status.gmt} · {status.workMode}</p>
		</PageHeader>

		{/* min-w-0: un hijo de grid trae min-width:auto y no baja de su contenido,
		    y la fila de LinkedIn estiraba la pista fuera de la pantalla a 320px */}
		<div class="mt-12 grid gap-12 lg:grid-cols-[1.35fr_1fr] lg:items-start">
			<div data-reveal class="min-w-0">
				<ContactForm />
			</div>

			<div class="min-w-0 space-y-10">
				<ul class="border-b border-base-300">
					<Channel label="Correo" value={contact.email} href={`mailto:${contact.email}`} copyable />
					<Channel
						label="WhatsApp"
						value={contact.phone}
						href={`https://wa.me/${telefono}?text=${greeting}`}
						logo={siWhatsapp.path}
						external
						copyable
					/>
					<Channel
						label="LinkedIn"
						value={contact.linkedin.replace(/^https?:\/\//, "")}
						href={contact.linkedin}
						icon="linkedin"
						external
					/>
				</ul>

				<aside data-reveal class="glass p-6">
					<h2 class="eyebrow">Para no ir y volver</h2>
					<p class="mt-4 text-sm text-base-content/70">Si me contás esto en el primer mensaje, te respondo con algo concreto:</p>
					<ul class="mt-5 space-y-3 text-sm text-base-content/70">
						{tips.map((item, i) => (
							<li class="flex gap-3">
								<span class="font-mono text-[0.65rem] leading-5 text-primary">{String(i + 1).padStart(2, "0")}</span>
								{item}
							</li>
						))}
					</ul>
				</aside>
			</div>
		</div>

		<Process />
		<Faq />
	</main>
</Layout>
