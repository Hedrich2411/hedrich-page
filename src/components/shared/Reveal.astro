---
// Revelador del sitio: cualquier [data-reveal] entra al asomar.
// Los componentes con coreografía propia usan [data-anim].
---

<script>
	import gsap from "gsap";

	// `amount` y no un retardo fijo: al navegar entran de golpe todos los de la
	// primera pantalla, y con 0.09 por elemento la cadena duraba 2.1 s.
	const ENTRADA = { duration: 0.55, stagger: { amount: 0.3 }, ease: "power3.out" };
	const sinMovimiento = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

	// Lo que estaba en la página anterior con la misma clave, como el índice de un
	// curso, ya está a la vista: entra quieto y solo se anima el contenido.
	document.addEventListener("astro:before-swap", (e) => {
		for (const nuevo of e.newDocument.querySelectorAll<HTMLElement>("[data-reveal-key]")) {
			const clave = CSS.escape(nuevo.dataset.revealKey ?? "");
			if (!document.querySelector(`[data-reveal-key="${clave}"]`)) continue;
			nuevo.dataset.revealed = "";
			nuevo.style.opacity = "1";
		}
	});

	// Lo que ya está en pantalla al llegar nunca asoma, así que el observador no
	// lo dispara.
	document.addEventListener("astro:after-swap", () => {
		const visibles = [...document.querySelectorAll<HTMLElement>("[data-reveal]:not([data-revealed])")].filter(
			(el) => el.getBoundingClientRect().top < innerHeight,
		);
		if (!visibles.length) return;
		for (const el of visibles) el.dataset.revealed = "";

		if (sinMovimiento()) {
			gsap.set(visibles, { opacity: 1, y: 0 });
			return;
		}

		gsap.fromTo(visibles, { opacity: 0, y: 16 }, { opacity: 1, y: 0, ...ENTRADA });
	});

	const init = () => {
		const mm = gsap.matchMedia();

		mm.add("(prefers-reduced-motion: reduce)", () => {
			gsap.set("[data-reveal]", { opacity: 1 });
		});

		mm.add("(prefers-reduced-motion: no-preference)", () => {
			const pendientes = document.querySelectorAll<HTMLElement>("[data-reveal]:not([data-revealed])");
			if (!pendientes.length) return;

			// threshold 0 y sin margen inferior: con un umbral mayor, una sección más
			// alta que el viewport nunca lo alcanza y no se revela nunca.
			const io = new IntersectionObserver(
				(entries) => {
					const entrando = entries.filter((e) => e.isIntersecting).map((e) => e.target);
					if (!entrando.length) return;
					for (const el of entrando) io.unobserve(el);
					gsap.fromTo(entrando, { y: 16 }, { y: 0, opacity: 1, ...ENTRADA });
				},
				{ threshold: 0 },
			);
			for (const el of pendientes) io.observe(el);
			return () => io.disconnect();
		});
	};

	document.addEventListener("astro:page-load", init);
</script>
