---
import { siWhatsapp } from "simple-icons";
import site from "../../data/site.json";

const { contact } = site;
const greeting = encodeURIComponent("Hola Hedrich, te escribo por un proyecto.");
const href = `https://wa.me/${contact.phone.replace(/\D/g, "")}?text=${greeting}`;
---

{/* Bottom-right on every size. Plain circle: the label
    that slid out on hover leaked through the padding and added nothing.
    The brand green is the one exception to the palette, for recognition. */}
<a
	href={href}
	target="_blank"
	rel="noopener"
	aria-label="Escribime por WhatsApp"
	title="Escribime por WhatsApp"
	class="fixed bottom-5 right-4 z-40 grid size-13 place-content-center rounded-full bg-[#25D366] text-white shadow-lg transition-transform duration-300 hover:scale-105 lg:bottom-6 lg:right-6"
>
	<svg class="size-6 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d={siWhatsapp.path} /></svg>
</a>
