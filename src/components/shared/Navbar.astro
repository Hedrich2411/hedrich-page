---
import Icon from "./Icon.astro";
import MobileMenu from "./MobileMenu.astro";
import NavLinks from "./NavLinks.astro";
---

<header
	transition:name="navbar"
	data-navbar
	class="sticky top-0 z-50 transition-colors duration-300 [&.is-stuck]:border-b [&.is-stuck]:border-base-300 [&.is-stuck]:bg-base-100/85 [&.is-stuck]:backdrop-blur-md"
>
	<div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-8 px-6 lg:h-20">
		<a href="/" class="py-2.5 text-sm uppercase tracking-[0.22em] transition-colors hover:text-primary">hedrich.dev</a>
		<div class="flex items-center gap-7">
			<NavLinks />
			<a href="/contacto" class="pill group hidden lg:inline-flex" aria-current={Astro.url.pathname.startsWith("/contacto") ? "page" : null}>
				Contacto
				<Icon name="arrow" class="size-3.5 transition-transform duration-300 group-hover:translate-x-0.5" />
			</a>

			{/* only the trigger lives in the bar: the panel it opens is a sibling of
			    this header, because `backdrop-filter` (and the transition name) make
			    this element a containing block and would shrink a fixed child to it */}
			<button
				data-menu-open
				type="button"
				aria-label="Abrir menú"
				aria-expanded="false"
				aria-controls="menu-movil"
				class="group grid size-10 shrink-0 place-content-center gap-1.25 rounded-full border border-base-300 transition-colors hover:border-primary lg:hidden"
			>
				<span class="block h-px w-4 bg-base-content transition-transform duration-300 group-hover:-translate-y-px"></span>
				<span class="block h-px w-4 bg-base-content transition-transform duration-300 group-hover:translate-y-px"></span>
			</button>
		</div>
	</div>
</header>

<MobileMenu />

<script>
	// the bar only grows a background once the page has scrolled past the top.
	// a plain scroll read beats an observer here: no sentinel to get wrong at load.
	const paint = () => {
		const bar = document.querySelector<HTMLElement>("[data-navbar]");
		bar?.classList.toggle("is-stuck", window.scrollY > 8);
	};

	// registered once at module scope, so navigations do not stack listeners
	addEventListener("scroll", paint, { passive: true });
	document.addEventListener("astro:page-load", paint);
</script>
