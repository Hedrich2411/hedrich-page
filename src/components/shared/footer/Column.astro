---
import Icon from "../Icon.astro";

export interface Item {
	label: string;
	href?: string;
	external?: boolean;
	highlight?: boolean;
}
interface Props { title: string; items: Item[] }
const { title, items } = Astro.props;
---

<div>
	<h3 class="eyebrow text-base-100/40!">{title}</h3>
	<ul class="mt-3 space-y-0">
		{items.map((item) => (
			<li>
				<a
					href={item.href}
					target={item.external ? "_blank" : null}
					rel={item.external ? "noopener" : null}
					class:list={[
						// the underline grows from the left, same as in the navbar
						// py-2.5 takes the row to a 40px tap target; the underline moves up by the
						// same amount so it still sits right under the text
						"group relative inline-flex items-center gap-1 py-2.5 text-sm transition-colors hover:text-base-100",
						"after:absolute after:inset-x-0 after:bottom-2 after:h-px after:origin-left after:scale-x-0 after:bg-base-100 after:transition-transform after:duration-[260ms] hover:after:scale-x-100",
						item.highlight ? "font-medium text-base-100" : "text-base-100/60",
					]}
				>
					{item.label}
					{item.external && (
						<Icon name="externalLink" class="size-3 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
					)}
				</a>
			</li>
		))}
	</ul>
</div>
