---
import { siGithub, siWhatsapp } from "simple-icons";
import site from "../../../data/site.json";
import Icon from "../Icon.astro";

const { contact } = site;
const whatsapp = `https://wa.me/${contact.phone.replace(/\D/g, "")}`;
const buttonClass =
	"flex size-10 items-center justify-center rounded-lg border border-white/15 text-base-100/60 transition-all duration-200 hover:-translate-y-0.5 hover:border-white/35 hover:bg-white/10 hover:text-base-100";
---

<ul class="mt-6 flex gap-2">
	<li>
		<a href={contact.github} target="_blank" rel="noopener" aria-label="GitHub" class={buttonClass}>
			<svg class="size-4 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d={siGithub.path} /></svg>
		</a>
	</li>
	<li>
		<a href={contact.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class={buttonClass}>
			<Icon name="linkedin" />
		</a>
	</li>
	<li>
		<a href={whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp" class={buttonClass}>
			<svg class="size-4 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d={siWhatsapp.path} /></svg>
		</a>
	</li>
	<li>
		<a href={`mailto:${contact.email}`} aria-label="Correo" class={buttonClass}>
			<Icon name="mail" />
		</a>
	</li>
</ul>
