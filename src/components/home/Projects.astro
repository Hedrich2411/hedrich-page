---
import { projects } from "../../lib/projects";
import SectionHead from "../shared/SectionHead.astro";
import Bento from "../projects/Bento.astro";
---

<section id="proyectos" class="py-20 sm:py-28">
	<SectionHead
		eyebrow="En producción"
		title="Proyectos"
		lead="Sistemas que están en producción y que alguien usa todos los días."
		action={{ href: "/proyectos", label: "Ver todos" }}
	/>

	<Bento projects={projects} />

</section>
