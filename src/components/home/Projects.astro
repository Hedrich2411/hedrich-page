---
import { projects } from "../../lib/projects";
import Icon from "../shared/Icon.astro";
import Card from "../projects/Card.astro";
---

<section id="proyectos" class="py-16 sm:py-24">
	<h2 data-reveal class="text-3xl font-extrabold tracking-tight">Proyectos</h2>
	<p data-reveal class="mt-3 max-w-prose text-base-content/60">
		Sistemas que están en producción y que alguien usa todos los días.
	</p>

	<ul class="relative mt-12 grid gap-6 sm:grid-cols-2">
		{projects.map((project) => <Card project={project} />)}
	</ul>

	<a
		data-reveal
		href="/proyectos"
		class="group mt-10 inline-flex items-center gap-2.5 rounded-full border border-base-300 py-2.5 pl-5 pr-4 text-sm font-medium transition-colors hover:border-primary hover:text-primary"
	>
		Ver todos los proyectos
		<span class="flex size-6 items-center justify-center rounded-full bg-base-200 transition-colors group-hover:bg-primary group-hover:text-primary-content">
			<Icon name="arrow" class="size-3.5 transition-transform duration-300 group-hover:translate-x-0.5" />
		</span>
	</a>
</section>
