---
interface Props { photos: string[] }
const { photos } = Astro.props;
---

<div data-stack class="relative mx-auto h-80 w-64 shrink-0 touch-none select-none sm:h-96 sm:w-72">
	{photos.map((photo, i) => (
		<div data-anim class="stack-card absolute inset-0 cursor-grab active:cursor-grabbing">
			{photo ? (
				<img src={photo} alt="" width="576" height="768" draggable="false" class="size-full rounded-2xl border border-base-300 object-cover shadow-xl" />
			) : (
				<div class="grid size-full place-content-center rounded-2xl border border-dashed border-base-content/25 bg-base-200 text-base-content/40 shadow-xl">
					<svg class="size-10" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="8.5" cy="10" r="1.5" /><path stroke-linecap="round" stroke-linejoin="round" d="m4 17 5-5 4 4 2-2 5 5" /></svg>
					<span class="mt-3 text-center text-xs">Foto {i + 1}</span>
				</div>
			)}
		</div>
	))}
</div>

<script>
	import gsap from "gsap";

	// position of each card by its place in the stack
	const POS = [
		{ rotation: -4, scale: 1, y: 0 },
		{ rotation: 1, scale: 0.94, y: 10 },
		{ rotation: 5, scale: 0.88, y: 20 },
	];
	const THROW = 90; // drag distance before the card flies off

	const init = () => {
		const stack = document.querySelector<HTMLElement>("[data-stack]");
		if (!stack) return;

		const cards = gsap.utils.toArray<HTMLElement>(".stack-card", stack);
		if (cards.length < 2) return;

		let order = [...cards];

		const layout = (duration = 0.55) =>
			order.forEach((card, i) => {
				const pos = POS[Math.min(i, POS.length - 1)];
				gsap.to(card, { ...pos, x: 0, zIndex: order.length - i, duration, ease: "power3.out" });
			});

		// the top one flies out and returns to the bottom of the stack
		const discard = (card: HTMLElement, dir: number) =>
			gsap.to(card, {
				x: dir * 420,
				rotation: dir * 28,
				opacity: 0,
				duration: 0.4,
				ease: "power2.in",
				onComplete: () => {
					order.push(order.shift()!);
					gsap.set(card, { x: 0, opacity: 0, zIndex: 0 });
					layout();
					gsap.to(card, { opacity: 1, duration: 0.35 });
				},
			});

		// Plain pointer events instead of GSAP Draggable: the plugin cost 30 KB
		// for one gesture the platform already reports.
		let startX = 0;
		let dragging: HTMLElement | null = null;

		stack.addEventListener("pointerdown", (e) => {
			const card = order[0];
			if (!card.contains(e.target as Node)) return;
			dragging = card;
			startX = e.clientX;
			card.setPointerCapture(e.pointerId);
		});

		stack.addEventListener("pointermove", (e) => {
			if (!dragging) return;
			const dx = e.clientX - startX;
			gsap.set(dragging, { x: dx, rotation: -4 + dx * 0.04 });
		});

		const release = (e: PointerEvent) => {
			if (!dragging) return;
			const dx = e.clientX - startX;
			const card = dragging;
			dragging = null;
			Math.abs(dx) > THROW ? discard(card, Math.sign(dx)) : layout(0.35);
		};
		stack.addEventListener("pointerup", release);
		stack.addEventListener("pointercancel", release);

		const mm = gsap.matchMedia();

		mm.add("(prefers-reduced-motion: no-preference)", () => {
			gsap.set(cards, { opacity: 1 });
			layout(0);
			// initial deal: the cards drop onto the stack
			gsap.from(cards, { y: -60, opacity: 0, scale: 0.8, rotation: 0, duration: 0.7, stagger: 0.12, ease: "back.out(1.4)" });

			// with repeat:-1 delayedCall's onComplete never fires; a timeline is needed
			const auto = gsap
				.timeline({ repeat: -1 })
				.to({}, { duration: 4.5 })
				.call(() => discard(order[0], -1));
			stack.addEventListener("pointerenter", () => auto.pause());
			stack.addEventListener("pointerleave", () => auto.restart(true));
			return () => auto.kill();
		});

		mm.add("(prefers-reduced-motion: reduce)", () => {
			gsap.set(cards, { opacity: 1 });
			layout(0);
		});
	};

	document.addEventListener("astro:page-load", init);
</script>
