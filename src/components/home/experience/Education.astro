---
import site from "../../../data/site.json";

const formatter = new Intl.DateTimeFormat("es-PE", { month: "long", year: "numeric" });
const dateLabel = (date: string) => formatter.format(new Date(`${date}-01T00:00:00`));
---

<div data-reveal-group class="mt-10 border-t border-base-300 pt-8">
	<h3 data-reveal class="text-sm font-semibold text-primary">Formación</h3>
	<ul data-reveal class="mt-4 space-y-1 text-sm">
		{site.education.map((item) => (
			<li>
				<span class="font-medium">{item.title}</span>
				<span class="text-base-content/50"> · {item.institution} · {dateLabel(item.date)}</span>
			</li>
		))}
	</ul>
</div>
