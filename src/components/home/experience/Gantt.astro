---
import { guides, jobs, todayX } from "../../../lib/experience";
---

<div data-chart class="mt-12">
	<!-- year axis -->
	<div class="flex gap-4">
		<div class="w-24 shrink-0 sm:w-40"></div>
		<div class="relative h-5 flex-1">
			{guides.map((guide, i) => (
				<span
					data-guide-label
					style={`left:${guide.x}%`}
					class:list={[
						"absolute top-0 -translate-x-1/2 whitespace-nowrap text-[11px] text-base-content/40",
						i === 0 && "hidden sm:block", // on mobile "jul 2022" overlaps "2023"
					]}
				>{guide.label}</span>
			))}
			<span data-today-label class="absolute top-0 -translate-x-1/2 rounded-full bg-primary/15 px-2 text-[11px] text-primary" style={`left:${todayX}%`}>hoy</span>
		</div>
	</div>

	<!-- Guides repeat on every row: with no gap between rows they read as one continuous line -->
	{jobs.map((job) => (
		<div data-row data-stack={job.stack.join(",")} class="flex gap-4">
			<div class="flex w-24 shrink-0 flex-col justify-center py-2 sm:w-40">
				<span class="text-sm font-semibold leading-tight">{job.role}</span>
				<span class="text-xs leading-tight text-base-content/50">{job.company}</span>
			</div>

			<div class="relative h-14 flex-1">
				{guides.map((guide) => (
					<span data-guide class="absolute inset-y-0 w-px bg-base-300" style={`left:${guide.x}%`} />
				))}
				<span data-today class="absolute inset-y-0 w-px origin-top bg-primary/40" style={`left:${todayX}%`} />

				<div
					data-bar
					style={`left:${job.left}%;width:${job.width}%`}
					class:list={[
						"absolute top-1/2 flex h-7 -translate-y-1/2 origin-left items-center rounded-md px-2",
						job.to ? "bg-primary/35" : "bg-primary",
					]}
				>
					{job.labelFits && (
						<span class:list={["truncate text-xs", job.to ? "text-base-content/80" : "text-primary-content"]}>
							<span data-months data-total={job.months}>{job.months}</span> meses{job.to ? "" : " · en curso"}
						</span>
					)}
				</div>

				<div
					data-pop
					style={`--pop-x:${(job.alignRight ? 100 - (job.left + job.width) : job.left).toFixed(3)}%`}
					class:list={[
						"pointer-events-none absolute inset-x-0 top-[calc(50%+20px)] z-30 rounded-xl border border-base-300 bg-base-200 p-3 text-xs leading-relaxed text-base-content/70 shadow-lg",
						"sm:inset-x-auto sm:w-[17rem]",
						job.alignRight ? "sm:right-[var(--pop-x)]" : "sm:left-[var(--pop-x)]",
					]}
				>
					{job.summary}
				</div>

				{!job.labelFits && (
					<span class="absolute top-1/2 ml-2 -translate-y-1/2 whitespace-nowrap text-xs text-base-content/50" style={`left:${job.left + job.width}%`}>
						<span data-months data-total={job.months}>{job.months}</span> meses
					</span>
				)}
			</div>
		</div>
	))}
</div>

<script>
	import gsap from "gsap";
	import { ROLE_EVENT, type RoleDetail } from "../../../lib/events";

	const init = () => {
		const chart = document.querySelector<HTMLElement>("[data-chart]");
		if (!chart) return;

		const rows = gsap.utils.toArray<HTMLElement>("[data-row]", chart);
		const bars = rows.map((row) => row.querySelector<HTMLElement>("[data-bar]")!);
		const pops = rows.map((row) => row.querySelector<HTMLElement>("[data-pop]")!);
		const guides = gsap.utils.toArray<HTMLElement>("[data-guide],[data-guide-label]", chart);
		const today = gsap.utils.toArray<HTMLElement>("[data-today],[data-today-label]", chart);
		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		let active = -1;

		gsap.set(pops, { opacity: 0, y: 6 });

		const highlight = (i: number) => {
			// overwrite "auto" only kills tweens touching the same property; with `true`
			// it also killed the entry scaleX and the bars stayed at zero width
			bars.forEach((bar, j) => gsap.to(bar, { opacity: i < 0 || j === i ? 1 : 0.35, duration: 0.25, overwrite: "auto" }));
			pops.forEach((pop, j) =>
				gsap.to(pop, {
					opacity: j === i ? 1 : 0,
					y: j === i ? 0 : 6,
					duration: j === i ? 0.3 : 0.2,
					ease: "power3.out",
					overwrite: "auto",
				}),
			);

			// the stack listens to this and decides which technologies to dim
			const detail: RoleDetail = { stack: i < 0 ? null : (rows[i].dataset.stack || "").split(",") };
			document.dispatchEvent(new CustomEvent(ROLE_EVENT, { detail }));
		};

		rows.forEach((row, i) => {
			row.addEventListener("pointerenter", () => highlight(i));
			row.addEventListener("pointerleave", () => highlight(active));
			row.addEventListener("click", () => {
				active = active === i ? -1 : i;
				highlight(active);
			});
		});

		if (reduce) return;

		gsap.set(guides, { opacity: 0 });
		gsap.set(bars, { scaleX: 0 });
		gsap.set(today, { scaleY: 0, opacity: 0 });

		const observer = new IntersectionObserver(
			(entries, self) => {
				if (!entries[0].isIntersecting) return;
				self.disconnect();

				gsap
					.timeline()
					.to(guides, { opacity: 1, duration: 0.4, stagger: 0.04 })
					.to(bars, { scaleX: 1, duration: 0.7, ease: "expo.out", stagger: 0.07 }, "-=0.1")
					.to(today, { scaleY: 1, opacity: 1, duration: 0.5, ease: "power2.out" }, "-=0.3");

				// months count up from 0 while the bar grows
				chart.querySelectorAll<HTMLElement>("[data-months]").forEach((span, i) => {
					const counter = { value: 0 };
					span.textContent = "0";
					gsap.to(counter, {
						value: Number(span.dataset.total),
						duration: 0.7,
						delay: 0.3 + i * 0.07,
						ease: "expo.out",
						onUpdate: () => (span.textContent = String(Math.round(counter.value))),
					});
				});
			},
			{ threshold: 0.2 },
		);
		observer.observe(chart);
	};

	document.addEventListener("astro:page-load", init);
</script>
