---
import { jobs, monthLabel } from "../../../lib/experience";
import { nameOf } from "../../../lib/technologies";
---

<!-- Same data as a table, for screen readers. The sr-only goes on the div:
     a <table> ignores width:1px, expands to its content and widens the document. -->
<div class="sr-only">
	<table>
		<caption>Experiencia laboral</caption>
		<thead>
			<tr><th>Puesto</th><th>Empresa</th><th>Periodo</th><th>Duración</th><th>Tecnologías</th></tr>
		</thead>
		<tbody>
			{jobs.map((job) => (
				<tr>
					<td>{job.role}</td>
					<td>{job.company}</td>
					<td>{monthLabel(job.from)} a {job.to ? monthLabel(job.to) : "hoy"}</td>
					<td>{job.months} meses</td>
					<td>{job.stack.map(nameOf).join(", ")}</td>
				</tr>
			))}
		</tbody>
	</table>
</div>
