---
interface Props { items: string[] }
const { items } = Astro.props;
---

<section class="mt-14">
	<h2 data-reveal class="heading text-2xl">Qué incluye</h2>
	<ul class="mt-8 grid gap-4 sm:grid-cols-2">
		{items.map((item, i) => (
			<li data-reveal class="glass relative p-5 pr-14 text-sm text-base-content/80">
				<span aria-hidden="true" class="corner-index">{String(i + 1).padStart(2, "0")}</span>
				{item}
			</li>
		))}
	</ul>
</section>
