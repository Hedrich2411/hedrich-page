---
/** matches the service slug, so a page can ask for its own scene */
export type SceneKind =
	| "integraciones-y-erp"
	| "aplicaciones-moviles"
	| "infraestructura-y-despliegue"
	| "sistemas-web-a-medida"
	| "rescate-de-proyectos";

interface Props {
	kind: SceneKind;
	class?: string;
}
const { kind, class: cls } = Astro.props;
---

{/* Drawn, not stocked: the palette drives them and nothing is downloaded. */}
{kind === "integraciones-y-erp" && (
	<svg class:list={["scene", cls]} viewBox="0 0 320 96" fill="none" aria-hidden="true">
		<path class="wire" d="M44 48h70M206 48h70" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 5" />
		<path class="wire wire-2" d="M160 30V14h70M160 66v16h70" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 5" />
		<rect x="12" y="32" width="32" height="32" rx="9" class="node" />
		<rect x="144" y="32" width="32" height="32" rx="9" class="node node-core" />
		<rect x="276" y="32" width="32" height="32" rx="9" class="node" />
		<rect x="230" y="2" width="28" height="24" rx="7" class="node" />
		<rect x="230" y="70" width="28" height="24" rx="7" class="node" />
		<circle r="3.5" class="packet"><animateMotion dur="3.2s" repeatCount="indefinite" path="M44 48h70" /></circle>
		<circle r="3.5" class="packet"><animateMotion dur="3.2s" begin="1.1s" repeatCount="indefinite" path="M206 48h70" /></circle>
	</svg>
)}

{kind === "aplicaciones-moviles" && (
	<svg class:list={["scene", cls]} viewBox="0 0 160 88" fill="none" aria-hidden="true">
		<rect x="58" y="4" width="44" height="80" rx="9" class="node" />
		<rect x="72" y="9" width="16" height="3" rx="1.5" fill="currentColor" opacity=".25" />
		<rect class="row" x="64" y="22" width="32" height="7" rx="3.5" />
		<rect class="row row-2" x="64" y="34" width="32" height="7" rx="3.5" />
		<rect class="row row-3" x="64" y="46" width="32" height="7" rx="3.5" />
		<rect class="row row-4" x="64" y="58" width="32" height="7" rx="3.5" />
	</svg>
)}

{kind === "infraestructura-y-despliegue" && (
	<svg class:list={["scene", cls]} viewBox="0 0 160 88" fill="none" aria-hidden="true">
		<rect x="34" y="12" width="92" height="20" rx="6" class="node" />
		<rect x="34" y="38" width="92" height="20" rx="6" class="node" />
		<rect x="34" y="64" width="92" height="20" rx="6" class="node" />
		<circle cx="46" cy="22" r="3" class="led" />
		<circle cx="46" cy="48" r="3" class="led led-2" />
		<circle cx="46" cy="74" r="3" class="led led-3" />
		<rect class="sweep" x="34" y="12" width="92" height="72" rx="6" />
	</svg>
)}

{kind === "sistemas-web-a-medida" && (
	<svg class:list={["scene", cls]} viewBox="0 0 160 88" fill="none" aria-hidden="true">
		<rect x="18" y="8" width="124" height="72" rx="8" class="node" />
		<path d="M18 24h124" stroke="currentColor" stroke-width="1" opacity=".18" />
		<circle cx="28" cy="16" r="2.5" fill="currentColor" opacity=".22" />
		<circle cx="37" cy="16" r="2.5" fill="currentColor" opacity=".22" />
		<rect class="bar" x="32" y="40" width="14" height="28" rx="3" />
		<rect class="bar bar-2" x="54" y="40" width="14" height="28" rx="3" />
		<rect class="bar bar-3" x="76" y="40" width="14" height="28" rx="3" />
		<rect class="bar bar-4" x="98" y="40" width="14" height="28" rx="3" />
	</svg>
)}

{kind === "rescate-de-proyectos" && (
	<svg class:list={["scene", cls]} viewBox="0 0 160 88" fill="none" aria-hidden="true">
		<rect x="22" y="14" width="116" height="18" rx="5" class="node" />
		<rect x="22" y="36" width="116" height="18" rx="5" class="node broken" />
		<rect x="22" y="58" width="116" height="18" rx="5" class="node" />
		<rect class="patch" x="22" y="36" width="116" height="18" rx="5" />
	</svg>
)}

<style>
	.scene { color: currentColor; }

	.node {
		fill: color-mix(in oklab, var(--color-base-content) 6%, transparent);
		stroke: color-mix(in oklab, var(--color-base-content) 14%, transparent);
		stroke-width: 1;
	}

	.node-core {
		fill: color-mix(in oklab, var(--color-primary) 14%, transparent);
		stroke: color-mix(in oklab, var(--color-primary) 40%, transparent);
	}

	.wire {
		color: color-mix(in oklab, var(--color-base-content) 22%, transparent);
		animation: flow 1.6s linear infinite;
	}
	.wire-2 { animation-duration: 2.4s; }
	@keyframes flow { to { stroke-dashoffset: -18; } }

	.packet { fill: var(--color-primary); }

	/* the rows of the app settle in one after another, then start over */
	.row {
		fill: color-mix(in oklab, var(--color-primary) 22%, transparent);
		animation: settle 3.4s ease-in-out infinite;
	}
	.row-2 { animation-delay: 0.18s; }
	.row-3 { animation-delay: 0.36s; }
	.row-4 { animation-delay: 0.54s; }
	@keyframes settle {
		0%, 8% { opacity: 0; transform: translateY(5px); }
		22%, 72% { opacity: 1; transform: translateY(0); }
		88%, 100% { opacity: 0; transform: translateY(-5px); }
	}

	.led { fill: var(--color-primary); animation: blink 2.6s ease-in-out infinite; }
	.led-2 { animation-delay: 0.5s; }
	.led-3 { animation-delay: 1s; }
	@keyframes blink { 0%, 40%, 100% { opacity: 0.3; } 55% { opacity: 1; } }

	/* a slow scan passing over the stack, the way a deploy walks the servers */
	.sweep {
		fill: none;
		stroke: color-mix(in oklab, var(--color-primary) 45%, transparent);
		stroke-width: 1.5;
		stroke-dasharray: 40 290;
		animation: scan 4.5s linear infinite;
	}
	@keyframes scan { to { stroke-dashoffset: -330; } }

	/* the bars of a panel filling up with real numbers */
	.bar {
		fill: color-mix(in oklab, var(--color-primary) 25%, transparent);
		transform-box: fill-box;
		transform-origin: bottom;
		animation: grow 3.6s ease-in-out infinite;
	}
	.bar-2 { animation-delay: 0.2s; }
	.bar-3 { animation-delay: 0.4s; }
	.bar-4 { animation-delay: 0.6s; fill: color-mix(in oklab, var(--color-primary) 60%, transparent); }
	@keyframes grow {
		0%, 10% { transform: scaleY(0.25); }
		45%, 70% { transform: scaleY(1); }
		95%, 100% { transform: scaleY(0.25); }
	}

	/* the broken row gets patched, over and over: that is the whole service */
	.broken {
		stroke-dasharray: 5 4;
		stroke: color-mix(in oklab, var(--color-base-content) 28%, transparent);
	}
	.patch {
		fill: none;
		stroke: var(--color-primary);
		stroke-width: 1.5;
		stroke-dasharray: 268;
		stroke-dashoffset: 268;
		animation: patch 4s ease-in-out infinite;
	}
	@keyframes patch {
		0%, 8% { stroke-dashoffset: 268; }
		55%, 78% { stroke-dashoffset: 0; }
		100% { stroke-dashoffset: -268; }
	}

	@media (prefers-reduced-motion: reduce) {
		.wire, .row, .led, .sweep, .bar, .patch { animation: none; }
		.row { opacity: 1; transform: none; }
		.bar { transform: none; }
		.patch { stroke-dashoffset: 0; }
		.packet { display: none; }
	}
</style>
