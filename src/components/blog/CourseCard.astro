---
import type { CourseOutline } from "../../lib/blog";
import { TECHNOLOGIES } from "../../lib/technologies";
import Icon from "../shared/Icon.astro";
import ProgressRing from "./ProgressRing.astro";

interface Props {
	outline: CourseOutline;
	/** position in the list, shown in the squared corner */
	index?: number;
	/** the first route is the dark one; the rest stay light */
	dark?: boolean;
}
const { outline, dark = false, index } = Astro.props;
const { course, sections, posts } = outline;
const label = course.data.kind === "curso" ? "Empezar el curso" : "Explorar el tutorial";
---

<li data-entry={course.data.topic} data-reveal class="flex">
	<a
		href={`/blog/${posts[0].id}`}
		class:list={[
			"group relative flex w-full flex-col p-7 transition-transform duration-300 hover:-translate-y-0.5",
			dark ? "glass-dark text-base-100" : "glass text-base-content",
		]}
	>
		{index !== undefined && (
			<span aria-hidden="true" class:list={["corner-index", dark && "bg-base-100/10! text-base-100/55!"]}>{String(index).padStart(2, "0")}</span>
		)}

		<div class="flex items-start justify-between gap-4">
			<p class:list={["eyebrow", dark ? "text-base-100/60!" : "text-primary!"]}>
				{course.data.kind} · {course.data.level}
			</p>
			<Icon name={course.data.kind === "curso" ? "braces" : "plug"} class:list={["size-5 shrink-0", dark ? "text-base-100/70" : "text-primary"]} />
		</div>

		<h3 class="mt-6 heading text-[1.7rem]">{course.data.title}</h3>

		<p class:list={["mt-4 flex-1 text-sm leading-relaxed", dark ? "text-base-100/70" : "text-base-content/70"]}>
			{course.data.description}
		</p>

		<ul class:list={["mt-6 flex flex-wrap items-center gap-x-2 text-xs", dark ? "text-base-100/60" : "text-primary"]}>
			{course.data.stack.map((slug, i) => (
				<>
					{i > 0 && <li aria-hidden="true" class="opacity-40">/</li>}
					<li>{TECHNOLOGIES[slug]?.name ?? slug}</li>
				</>
			))}
		</ul>

		<ProgressRing
			ids={posts.map((p) => p.id)}
			shape="bar"
			tone={dark ? "invert" : "default"}
			unit="entradas leídas"
			suffix={` · ${sections.length} ${sections.length === 1 ? "sección" : "secciones"}`}
			class="mt-6"
		/>

		<span class:list={["mt-6 flex items-center justify-between border-t pt-5 text-sm font-medium", dark ? "border-base-100/15" : "border-primary/15 text-primary"]}>
			{label}
			<Icon name="externalLink" class="size-4 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
		</span>
	</a>
</li>
