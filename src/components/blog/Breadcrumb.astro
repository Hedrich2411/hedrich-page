---
interface Props { trail: { label: string; href?: string }[] }
const { trail } = Astro.props;
---

<nav aria-label="Ruta" class="flex flex-wrap items-center gap-2 text-sm text-base-content/50">
	{trail.map((step, i) => (
		<>
			{i > 0 && <span aria-hidden="true" class="text-base-content/25">/</span>}
			{step.href ? (
				<a href={step.href} class="text-primary transition-colors hover:text-primary/70">{step.label}</a>
			) : (
				<span aria-current="page">{step.label}</span>
			)}
		</>
	))}
</nav>
