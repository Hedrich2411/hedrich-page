---
import { type Post } from "../../lib/blog";
import Icon from "../shared/Icon.astro";

interface Props {
	previous?: Post;
	next?: Post;
	/** 1-based position of `next` in the course, for its eyebrow */
	nextIndex: number;
	/** 1-based position of `previous` */
	previousIndex: number;
	/** where "back to the course" points when there is no next lesson */
	courseHref?: string;
}
const { previous, next, nextIndex, previousIndex, courseHref } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
---

{/* the previous lesson is a quiet row: going back is useful, not the main path */}
{previous && (
	<a
		data-reveal
		href={`/blog/${previous.id}`}
		class="group mt-10 flex items-center gap-3 text-sm text-base-content/60 transition-colors hover:text-primary"
	>
		<Icon name="arrow" class="size-4 shrink-0 rotate-180 transition-transform duration-300 group-hover:-translate-x-0.5" />
		<span class="min-w-0">
			Lección {pad(previousIndex)} · <span class="font-medium">{previous.data.title}</span>
		</span>
	</a>
)}

{next ? (
	<a
		data-reveal
		href={`/blog/${next.id}`}
		class:list={["glass group flex flex-col gap-5 p-7 sm:flex-row sm:items-center sm:justify-between", previous ? "mt-4" : "mt-10"]}
	>
		<span class="min-w-0">
			<span class="eyebrow text-primary!">Siguiente / Lección {pad(nextIndex)}</span>
			<span class="mt-3 block heading text-2xl">{next.data.title}</span>
			<span class="mt-2 block text-sm text-base-content/60">{next.data.description}</span>
		</span>

		<span class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-primary px-5 py-3 text-sm font-semibold text-primary-content transition-colors group-hover:bg-primary/90">
			Continuar
			<Icon name="arrow" class="size-4 transition-transform duration-300 group-hover:translate-x-0.5" />
		</span>
	</a>
) : (
	/* last lesson: nowhere to continue, so the card closes the course instead */
	<a
		data-reveal
		href={courseHref ?? "/blog"}
		class:list={["glass group flex flex-col gap-5 p-7 sm:flex-row sm:items-center sm:justify-between", previous ? "mt-4" : "mt-10"]}
	>
		<span class="min-w-0">
			<span class="eyebrow text-primary!">Última lección</span>
			<span class="mt-3 block heading text-2xl">Terminaste el curso</span>
			<span class="mt-2 block text-sm text-base-content/60">
				Volvé al índice para repasar cualquier lección o seguir con otro curso.
			</span>
		</span>

		<span class="inline-flex shrink-0 items-center gap-2 rounded-xl border border-primary/25 px-5 py-3 text-sm font-semibold text-primary transition-colors group-hover:border-primary">
			Ver el índice
			<Icon name="arrow" class="size-4 transition-transform duration-300 group-hover:translate-x-0.5" />
		</span>
	</a>
)}
