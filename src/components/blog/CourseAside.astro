---
import type { CourseOutline } from "../../lib/blog";
import { readingTime } from "../../lib/blog";
import Icon from "../shared/Icon.astro";
import ProgressRing from "./ProgressRing.astro";

interface Props { outline: CourseOutline; current: string }
const { outline, current } = Astro.props;
const { course, sections, posts } = outline;
const minutes = posts.reduce((total, post) => total + readingTime(post), 0);
// the lesson number runs across the whole course, not per section
const numberOf = (id: string) => String(posts.findIndex((p) => p.id === id) + 1).padStart(2, "0");
---

<aside data-reveal class="lg:sticky lg:top-24">
	{/* a panel that folds away on phones and stays open on the desktop rail */}
	<details data-course-index class="group">
		<summary class="flex cursor-pointer list-none items-start gap-3 lg:cursor-default">
			<span class="min-w-0 flex-1">
				<span class="block text-[11px] font-semibold uppercase tracking-[0.14em] text-primary">
					{course.data.kind} / {course.data.level}
				</span>
				<span class="mt-2 block text-lg font-extrabold leading-tight tracking-tight">{course.data.title}</span>
			</span>
			<Icon name="arrow" class="size-4 shrink-0 rotate-90 text-base-content/40 transition-transform duration-300 group-open:-rotate-90 lg:hidden" />
		</summary>

		<p class="mt-3 text-xs text-base-content/50">
			{posts.length} {posts.length === 1 ? "lección" : "lecciones"} · {minutes} min en total
		</p>

		<ProgressRing ids={posts.map((p) => p.id)} shape="bar" unit="lecciones completadas" labelBelow class="mt-4" />

		<nav class="mt-6 max-h-[60vh] overflow-y-auto lg:max-h-[calc(100vh-20rem)]">
			{sections.map((section, s) => (
				<div class="mt-6 first:mt-0">
					<p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-base-content/40">
						{String(s + 1).padStart(2, "0")} / {section.title}
					</p>

					<ol class="mt-3 space-y-1">
						{section.posts.map((post) => {
							const active = post.id === current;
							return (
								<li>
									<a
										href={`/blog/${post.id}`}
										aria-current={active ? "page" : null}
										class:list={[
											"flex gap-3 rounded-lg border-l-2 py-2.5 pl-3 pr-2 text-sm transition-colors",
											active
												? "border-primary bg-primary/10 text-primary"
												: "border-transparent text-base-content/70 hover:border-base-300 hover:text-primary",
										]}
									>
										<span class="shrink-0 tabular-nums text-xs leading-5 opacity-60">{numberOf(post.id)}</span>
										<span class="min-w-0 flex-1 leading-snug">
											<span class:list={["block", active && "font-semibold"]}>{post.data.title}</span>
											<span class="mt-1 block text-xs font-normal text-base-content/45">
												{active ? `Leyendo ahora · ${readingTime(post)} min` : `${readingTime(post)} min de lectura`}
											</span>
											<span data-tick={post.id} class="hidden"></span>
										</span>
									</a>
								</li>
							);
						})}
					</ol>
				</div>
			))}
		</nav>

		<div class="mt-6 border-t border-base-300 pt-5">
			<p class="text-xs text-base-content/45">Tu progreso se guarda solo en este navegador.</p>
			<a href="/blog" class="group/link mt-3 inline-flex items-center gap-2 text-sm text-primary">
				<Icon name="arrow" class="size-4 rotate-180 transition-transform duration-300 group-hover/link:-translate-x-0.5" />
				Volver al blog
			</a>
		</div>
	</details>
</aside>

<script>
	// open on the desktop rail, folded on phones: <details open> cannot be media-queried
	const init = () => {
		const index = document.querySelector<HTMLDetailsElement>("[data-course-index]");
		if (index) index.open = matchMedia("(min-width: 1024px)").matches;
	};

	document.addEventListener("astro:page-load", init);
</script>
