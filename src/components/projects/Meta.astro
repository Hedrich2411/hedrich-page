---
import { TECHNOLOGIES } from "../../lib/technologies";

interface Props { stack: string[]; url: string }
const { stack, url } = Astro.props;
---

<!-- Horizontal bar: as a vertical card it left the text column in an L shape -->
<div data-reveal class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 border-y border-base-300 py-4">
	{stack.map((slug) => (
		<span class="flex items-center gap-1.5 text-sm text-base-content/70">
			<svg class="size-4 shrink-0 fill-current text-base-content/45" viewBox="0 0 24 24" aria-hidden="true"><path d={TECHNOLOGIES[slug].path} /></svg>
			{TECHNOLOGIES[slug].name}
		</span>
	))}
	{url && <a class="link ml-auto text-sm" href={url} target="_blank" rel="noopener">Ver el proyecto</a>}
</div>
