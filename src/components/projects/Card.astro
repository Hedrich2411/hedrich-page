---
import type { Project } from "../../lib/projects";
import { TECHNOLOGIES } from "../../lib/technologies";
import Phone from "./Phone.astro";

interface Props { project: Project; class?: string; index?: number }
const { project, class: cls, index } = Astro.props;
const cover = project.shots[0];
const isMobile = project.screens.length > 0;
---

<li data-card data-stack={project.stack.join(",")} data-reveal class={cls}>
	<a
		href={`/proyectos/${project.slug}`}
		class="glass group relative flex h-full flex-col overflow-hidden transition-shadow duration-300 hover:shadow-window"
	>
		{index !== undefined && <span aria-hidden="true" class="corner-index z-10">{String(index).padStart(2, "0")}</span>}
		{/* el teléfono asoma desde abajo: se recorta contra el 16/10 de la tarjeta */}
		{isMobile ? (
			<div class="flex aspect-[16/10] items-end justify-center overflow-hidden bg-base-100/70 px-6 pt-8">
				<Phone
					isStatic
					screens={project.screens}
					name={project.name}
					transitionName={`portada-${project.slug}`}
					class="w-[7.5rem]"
				/>
			</div>
		) : cover ? (
			<div class="aspect-[16/10] overflow-hidden bg-base-100/70">
				<img
					transition:name={`portada-${project.slug}`}
					src={cover}
					alt=""
					width="1200"
					height="750"
					loading="lazy"
					class="size-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
				/>
			</div>
		) : null}

		<div class="flex flex-1 flex-col p-6">
			<p class="eyebrow">{project.kind} · {project.year}</p>
			<h3 class="mt-1 heading text-xl transition-colors group-hover:text-primary">
				{project.name}
			</h3>
			<p class="mt-2 flex-1 text-sm text-base-content/70">{project.summary}</p>

			<ul class="mt-5 flex flex-wrap gap-1.5">
				{project.stack.slice(0, 4).map((slug) => <li class="chip">{TECHNOLOGIES[slug].name}</li>)}
			</ul>

			{/* the arrow lives in the squared corner, like the reference cards */}
			<span class="absolute bottom-5 right-5 text-primary opacity-0 transition-all duration-300 group-hover:opacity-100">
				<svg class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
			</span>
		</div>
	</a>
</li>
