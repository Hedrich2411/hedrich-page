---
import { TECHNOLOGIES } from "../../lib/technologies";
interface Props { slugs: string[] }
const { slugs } = Astro.props;
---

<div data-filters class="mt-10 flex flex-wrap gap-2">
	<button
		type="button"
		data-filter="todos"
		aria-pressed="true"
		class="rounded-full border border-base-300 px-3.5 py-1.5 text-xs font-medium transition-colors aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-content"
	>
		Todos
	</button>

	{slugs.map((slug) => (
		<button
			type="button"
			data-filter={slug}
			aria-pressed="false"
			class="flex items-center gap-1.5 rounded-full border border-base-300 px-3.5 py-1.5 text-xs font-medium transition-colors aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-content"
		>
			<svg class="size-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d={TECHNOLOGIES[slug].path} /></svg>
			{TECHNOLOGIES[slug].name}
		</button>
	))}
</div>

<p data-empty class="mt-8 hidden text-base-content/60">Nada con esa tecnología todavía.</p>

<script>
	const init = () => {
		const bar = document.querySelector<HTMLElement>("[data-filters]");
		const empty = document.querySelector<HTMLElement>("[data-empty]");
		if (!bar) return;

		const buttons = [...bar.querySelectorAll<HTMLElement>("[data-filter]")];
		const cards = [...document.querySelectorAll<HTMLElement>("[data-card]")];

		const filter = (value: string) => {
			buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.filter === value)));

			let visible = 0;
			for (const card of cards) {
				const enters = value === "todos" || (card.dataset.stack || "").split(",").includes(value);
				card.classList.toggle("hidden", !enters);
				if (enters) visible++;
			}
			empty?.classList.toggle("hidden", visible > 0);
		};

		buttons.forEach((b) => b.addEventListener("click", () => filter(b.dataset.filter || "todos")));
	};

	document.addEventListener("astro:page-load", init);
</script>
